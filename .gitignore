node_modules/
dist/
dist-safari/
*.log
.DS_Store
.claude/
hi-chu-*.zip

# The demo stills the README embeds (demo/03-own-hover.png, demo/10-move-earthquake.png)
# ARE committed so it renders reliably; intermediate/large recordings are not. A recording
# is the expensive kind of file to commit — it stays in every clone forever, so keep the
# README on stills and host anything heavier outside the repo (see CLAUDE.md → Contributing).
demo/*.mp4
demo/*-raw.gif

# Chrome Web Store upload assets (generated; not repo content)
store-screenshots/

# `node scripts/make-icons.mjs --proof` output — a sheet to look at while tuning the mark,
# never shipped. The icons themselves ARE committed.
.icon-proof/

# `npm run screenshots` output — candidate shots from a throwaway battle; the keepers
# get copied into demo/ and store-screenshots/ by hand.
screenshots/

# The self-hosted Showdown server `player-check`/`screenshots` battle against (see
# scripts/lib/local-server.mjs) — cloned + npm installed on first run, not repo content.
.ps-server/

# Chrome for Testing, downloaded on first `visual-check` run (see
# scripts/lib/extension-chrome.mjs) — a 355MB browser, not repo content.
.chrome-for-testing/

# Xcode's own build cache for the Safari port (safari/hi-chu/) — regenerable, huge,
# machine-specific; the Xcode project source itself is tracked.
safari/build/
dist-visual/
