{
  "name": "hi-chu",
  "version": "0.25.0",
  "description": "Battle hints on hover for Pokémon Showdown: move damage, opponent's possible sets, and who's faster.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build:safari": "node scripts/build-safari.mjs",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/tsconfig.pure.json",
    "check": "npm run typecheck && npm run lint && npm run test && npm run deps && npm run graph:check",
    "drift-check": "node scripts/drift-check.mjs",
    "player-check": "node scripts/player-check.mjs",
    "release-check": "npm run build && npm run check && npm run drift-check && npm run player-check",
    "release-status": "node scripts/release-status.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "release-bump": "node scripts/release-bump.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:visual-check": "node scripts/build-visual-check.mjs",
    "visual-check": "npm run build:visual-check && REAL_EXTENSION=1 node scripts/screenshots.mjs",
    "previews": "node scripts/previews.mjs",
    "deps": "depcruise \"src/**/*.ts\" \"fitness/**/*.ts\" \"gallery/**/*.ts\" --config .dependency-cruiser.cjs",
    "graph": "node scripts/graph.mjs",
    "graph:check": "node scripts/graph.mjs --check",
    "lint": "oxlint --deny-warnings src fitness gallery scripts build.mjs",
    "fitness-retro": "node scripts/fitness-retro.mjs",
    "choice-exclusions": "node scripts/choice-exclusions.mjs"
  },
  "dependencies": {
    "@smogon/calc": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.77.0",
    "puppeteer-core": "^25.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
